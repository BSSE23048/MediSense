# MediSense AI Backend Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
PORT=5000

# LLM API Keys (at least one required)
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# GROQ_API_KEY=your-groq-api-key-here
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# LLM Provider (gemini, openai, groq)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Voice Assistant (Cloud STT + TTS)
VOICE_STT_PROVIDER=groq
VOICE_STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 language code, or 'auto' to auto-detect
VOICE_STT_LANGUAGE=en
VOICE_TTS_PROVIDER=elevenlabs
VOICE_TTS_MODEL=eleven_turbo_v2_5
VOICE_TTS_VOICE=21m00Tcm4TlvDq8ikWAM
VOICE_TTS_FORMAT=mp3
VOICE_TIMEOUT_SECONDS=30
VOICE_MAX_AUDIO_MB=8
VOICE_MAX_TTS_CHARS=1200

# OCR Configuration
# For Windows, provide full path to tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
USE_EASYOCR=false

# RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Cloudinary Configuration (Optional - for file storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

